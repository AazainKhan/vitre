<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Implied by permissions/orientation below; none of them should hide Glass from a box without it. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- OS takeover (P292): start exported=false components of other apps (Fire OS Settings' ExtensionHostActivity).
         Lint calls this system-app-only; Glass is installed as a privileged system app (the glass-system module). -->
    <uses-permission android:name="android.permission.START_ANY_ACTIVITY" tools:ignore="ProtectedPermissions" />
    <!-- OS takeover (P292): open Amazon's guarded settings pages (PREFERENCES, DISPLAY_AND_SOUNDS, MY_ACCOUNT...). -->
    <uses-permission android:name="com.amazon.tv.permission.LAUNCHER_SETTINGS" />
    <!-- Downloads (dataSync foreground service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Playing on a Sonos speaker: capture other apps' audio. Runtime RECORD_AUDIO plus the MediaProjection dialog, every session. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The Now Playing visualizer taps the output mix (audio session 0), which needs this as well as RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Which apps are being installed or updated and how far along (a tile badge and a capsule, P168). A normal permission. -->
    <uses-permission android:name="android.permission.READ_INSTALL_SESSIONS" />
    <!-- Install card's signer check: an installed app that has no launcher entry must still be visible on API 30. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Without it the system uninstaller closes the moment it opens (Android 9+). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Control Center: Wi-Fi network name (Android reveals SSIDs only with location access) and Bluetooth state. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Scanning for the remote on API 28-30 (P75 B). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <!-- Own remote pairing (Settings > Root): bonding without a user prompt. Only granted to a privileged system
         app (module glass-system, whose privapp allowlist is generated from this list); otherwise just not granted. -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <!-- App switcher: recent apps from usage history (granted over adb), and closing them. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- App switcher's real task list (I08): normal permission, but getRecentTasks returns every app's tasks
         (not just Glass's own) to a GET_TASKS holder that's also a privileged uid, which glass-system makes Glass. -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Granted manually over adb; lets the app set itself as screensaver and enable its Home button fallback. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        AirPlay (Control Center): drives PhairPlay's receiver through its signature-guarded control
        receiver (scripts/phairplay). Declared here too, so the grant doesn't depend on install order.
    -->
    <permission
        android:name="com.phairplay.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.phairplay.permission.CONTROL" />

    <!-- Add-ons (A1): their services require this, and only Glass's signature holds it, so only Glass can bind them. -->
    <permission
        android:name="dev.glasslauncher.permission.BIND_ADDON"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.glasslauncher.permission.BIND_ADDON" />

    <!--
        Glass Browser (a separate, unprivileged APK built by scripts/browser). Declared here too, like the one above;
        only apps signed with Glass's key can be opened by Glass, be talked to, or send it a download or keyboard request.
    -->
    <permission
        android:name="dev.glasslauncher.permission.BROWSER"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.glasslauncher.permission.BROWSER" />

    <!--
        Other apps' TV channels (Continue Watching). Only granted when Glass runs as a privileged system
        app (Settings › Root › System App); as a normal app these are simply not granted.
    -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.android.providers.tv.permission.ACCESS_WATCHED_PROGRAMS" tools:ignore="ProtectedPermissions" />

    <!-- Restart (system app) and Clean Up's bulk cache clear (P83 M5): privileged; scripts/privapp-check allowlists them. -->
    <uses-permission android:name="android.permission.REBOOT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CLEAR_APP_CACHE" tools:ignore="ProtectedPermissions" />
    <!-- Power Off's CEC standby to the TV (I09): privileged; scripts/privapp-check allowlists it. Without the grant, PowerControl just skips CEC and sleeps the stick. -->
    <uses-permission android:name="android.permission.HDMI_CEC" tools:ignore="ProtectedPermissions" />
    <!-- One-press install without the system card (ApkInstall, P119): privileged, so scripts/privapp-check allowlists it. -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Control Center's VPN pill: which installed apps are VPN apps. -->
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
        <!-- Add-ons (A1): installed apps that declare a Glass add-on service. -->
        <intent>
            <action android:name="dev.glasslauncher.ADDON" />
        </intent>
        <package android:name="com.phairplay.firetv" />
        <package android:name="com.phairplay.googletv" />
        <package android:name="com.glasslauncher.browser" />
        <package android:name="com.amazon.vizzini" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="stremio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Icon packs: where a store can be reached from (Settings > Icon Pack > Get an Icon Pack). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:name=".GlassApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassLauncher">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="fireos.intent.category.MAIN_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dream.AerialActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GlassLauncher" />

        <service
            android:name=".dream.AerialDreamService"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".widgets.NowPlayingService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".system.RescueActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":rescue"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".system.HomeGuardService"
            android:exported="true"
            android:label="@string/home_guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_guard" />
        </service>


        <service
            android:name=".system.RemoteKeysService"
            android:exported="true"
            android:label="@string/remote_keys_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_keys" />
        </service>

        <service
            android:name=".sonos.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".sonos.CaptureConsentActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".system.SleepTimer$Receiver"
            android:exported="false" />
        <!-- Always-on remote scan (P100): the system delivers matching adverts here, even with Glass's process dead. -->
        <receiver
            android:name=".system.RemoteScanReceiver"
            android:exported="false" />
        <!-- Device banners (P208): ACL broadcasts start the process even when nothing of Glass is running. The Bluetooth app sends them, so exported. -->
        <receiver
            android:name=".system.AclReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".system.InstallResultReceiver"
            android:exported="false" />
        <!-- Device tests only: the Control Center overlay's tree (uiautomator can't see overlays). -->
        <receiver
            android:name=".system.DebugDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Hands a finished download to the system chooser (Downloads manager, Select on a non-APK file). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/download_paths" />
        </provider>
    </application>
</manifest>
