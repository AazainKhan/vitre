#!/usr/bin/env python3
"""TypeSafe Jev helpers for the stick tests (P346). The API key is read from the macOS Keychain at run time
(service TYPESAFE_API_KEY) and never written anywhere; device serials and IPs are scrubbed before sending.

    scripts/jev route [REV]        which test tier a commit needs: none | emulator | stick-perf | stick-hw
    scripts/jev triage FILE        why a stick check failed, from a log window: surface-hidden | capture-silent |
                                   gl-died | crash | memory | reboot | unknown
    scripts/jev replay             both, on the P334-P345 rounds, against the plain path/regex rules

Below MIN_CONF the answer is "unsure" and the caller runs the stick test anyway.
"""
import json, os, re, subprocess, sys, urllib.request

URL = "https://api.typesafe.ai/v1/systemone"
MIN_CONF = 0.7
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

TIERS = {
    "none": "docs, comments, scripts or tests only: nothing that runs on a device changes",
    "emulator": "UI, layout, settings or logic that behaves the same on any Android TV: the emulator is enough",
    "stick-perf": "frame time, GPU/shader, animation, memory or CPU cost: must be measured on the real Fire TV stick",
    "stick-hw": "Bluetooth, remotes, HDR, audio capture, accessibility or Fire-OS-specific behaviour: needs the real stick's hardware",
}
CAUSES = {
    "surface-hidden": "the app keeps drawing but its SurfaceView layer is hidden or released (SF flag 0x1, 'native window', detached)",
    "capture-silent": "the audio capture returns no data or zeros while music plays",
    "gl-died": "the GL render thread stops or is recreated (stats stop, a new tid)",
    "crash": "the app process crashed (FATAL EXCEPTION, AndroidRuntime, a tombstone)",
    "memory": "memory grows: PSS, Native Heap or Graphics rows rise and stay up",
    "reboot": "the device rebooted or system_server died (watchdog, binder deaths, boot)",
    "unknown": "none of the above",
}


def key():
    return subprocess.run(["security", "find-generic-password", "-a", os.environ["USER"], "-s", "TYPESAFE_API_KEY", "-w"],
                          capture_output=True, text=True, check=True).stdout.strip()


def scrub(s):
    ser = subprocess.run("adb get-serialno", shell=True, capture_output=True, text=True).stdout.strip()
    s = re.sub(r"\b\d{1,3}(?:\.\d{1,3}){3}(?::\d+)?\b", "<ip>", s)
    for x in filter(None, {ser, subprocess.run("adb shell getprop ro.serialno", shell=True, capture_output=True, text=True).stdout.strip()}):
        if len(x) > 4:
            s = s.replace(x, "<serial>")
    return s


def ask(state, instructions, criteria):
    body = {"model": "jev-latest", "state": scrub(state)[-60000:],
            "questions": {"q": {"type": "choice", "instructions": instructions, "criteria": criteria}}}
    req = urllib.request.Request(URL, json.dumps(body).encode(), {"Authorization": "Bearer " + key(), "Content-Type": "application/json"})
    a = json.load(urllib.request.urlopen(req, timeout=60))["answers"]["q"]
    return (a["choice"] if a["confidence"] >= MIN_CONF else "unsure"), round(a["confidence"], 2)


# ---------- the plain rules Jev has to beat ----------
def route_rule(files):
    if all(re.search(r"\.(md|txt)$|^scripts/|^docs/|/test/", f) for f in files):
        return "none"
    if any(re.search(r"Bt|Bluetooth|RemoteKeys|Hdr|Gamepad|AudioAnalysis|Visualizer\.kt|Capture", f) for f in files):
        return "stick-hw"
    if any(re.search(r"/viz/|Gl\.kt|Shader|perf|Transition|Blur|Bake|NowPlayingSaver|AerialDream", f) for f in files):
        return "stick-perf"
    return "emulator"


def triage_rule(text):
    for pat, cause in [(r"flags=0x0*3\b|native window|detached \|", "surface-hidden"), (r"FATAL EXCEPTION|AndroidRuntime: E|tombstone", "crash"),
                       (r"SYSTEM_SERVER_WATCHDOG|uptime drop|sys\.boot\.reason", "reboot"), (r"capture silent|signal=false", "capture-silent"),
                       (r"TOTAL PSS|Native Heap", "memory")]:
        if re.search(pat, text):
            return cause
    return "unknown"


def commit_text(rev):
    return subprocess.run(["git", "-C", ROOT, "show", "--stat", "--format=%s%n%n%b", rev], capture_output=True, text=True).stdout[:6000]


def commit_files(rev):
    return subprocess.run(["git", "-C", ROOT, "show", "--name-only", "--format=", rev], capture_output=True, text=True).stdout.split()


def route(rev):
    return ask(commit_text(rev), "Which device test tier does this Android TV launcher commit need before merge?", TIERS)


def triage(text):
    return ask(text, "A stick check of an Android TV launcher's screensaver failed. Which cause does this log window show?", CAUSES)


# Ground truth from what each round actually needed or found (P334-P345, 2026-11-13/14).
ROUTE_TRUTH = {
    "37e48c9c": "stick-perf", "b426ebbd": "stick-perf", "7ab66dc9": "stick-perf", "764c29d8": "stick-perf",
    "20f3b3d3": "stick-hw", "ac242e03": "stick-hw", "140cf022": "stick-perf", "e24b1c83": "stick-perf",
    "5596a8c1": "stick-perf", "fb7431b1": "emulator", "643cd6e2": "stick-perf", "7f4e8c10": "stick-perf",
    "b4a9c4d8": "stick-perf", "28558445": "emulator", "f2f6ca0a": "stick-hw", "2ca97c5e": "emulator",
}
SCR = os.path.expanduser("~/Documents/glass-launcher/scratch-p327")
TRIAGE_TRUTH = [  # (file, line range or None, truth)
    ("d7-logcat.txt", ("01:22:30", "01:22:40"), "surface-hidden"),
    ("lv-spec6-logcat.txt", ("00:58:15", "00:59:00"), "surface-hidden"),
    ("lv-spec5-logcat.txt", ("00:24:20", "00:25:00"), "surface-hidden"),
    ("m-home-final.txt", None, "memory"),
]


def window(path, rng):
    lines = open(path, errors="replace").read().splitlines()
    if rng:
        lines = [l for l in lines if rng[0] <= l[6:14] <= rng[1]]
    return "\n".join(lines)[-20000:]


def replay():
    out = {"route": [], "triage": []}
    for rev, truth in ROUTE_TRUTH.items():
        j, c = route(rev)
        out["route"].append({"rev": rev, "truth": truth, "rule": route_rule(commit_files(rev)), "jev": j, "conf": c})
    for f, rng, truth in TRIAGE_TRUTH:
        p = os.path.join(SCR, f)
        if not os.path.exists(p):
            continue
        text = window(p, rng)
        j, c = triage(text)
        out["triage"].append({"file": f, "truth": truth, "rule": triage_rule(text), "jev": j, "conf": c})
    for k in ("route", "triage"):
        rows = out[k]; n = len(rows)
        out[f"{k}_score"] = {"n": n, "rule": sum(r["rule"] == r["truth"] for r in rows), "jev": sum(r["jev"] == r["truth"] for r in rows),
                             "jev_unsure": sum(r["jev"] == "unsure" for r in rows)}
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    cmd = sys.argv[1:] or ["replay"]
    if cmd[0] == "route":
        # Replay 2026-11-14: Jev alone 11/16 with 0 confident misses (5 unsure), path rules 13/16, Jev-then-rule 15/16.
        rev = cmd[1] if len(cmd) > 1 else "HEAD"
        j, c = route(rev)
        print(json.dumps({"tier": j if j != "unsure" else route_rule(commit_files(rev)), "jev": j, "conf": c}))
    elif cmd[0] == "triage":
        # Replay 2026-11-14 (n=4): Jev 1/4, regex 2/4, so stickcheck uses triage_rule; this stays for manual use.
        text = open(cmd[1], errors="replace").read()[-20000:]
        j, c = triage(text)
        print(json.dumps({"rule": triage_rule(text), "jev": j, "conf": c}))
    elif cmd[0] == "replay":
        replay()
    else:
        print(__doc__); sys.exit(2)
